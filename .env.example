# ---------------------------------------------------------------------------
# Pixora environment
#
# Only variables prefixed with VITE_ are exposed to the browser. Everything
# else is read server-side by the functions in /api and never shipped to users.
# ---------------------------------------------------------------------------

# --- Supabase (auth + Postgres + storage) -----------------------------------
# Project Settings -> API. Use the publishable/anon key only — never the
# service-role key, which bypasses Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# --- Media provider ----------------------------------------------------------
# Server-side only. Free key from https://pixabay.com/api/docs/
# When this is omitted, Pixora automatically serves its bundled demo library so
# the product still works end-to-end without any paid account.
PIXABAY_API_KEY=

# --- Public site metadata ----------------------------------------------------
# Used for canonical URLs, social cards and email redirect links.
VITE_SITE_URL=https://pixora.example.com
